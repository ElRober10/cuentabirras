{
  "expo": {
    "name": "CuentaBirras",
    "slug": "CuentaBirras",
    "version": "1.0.0",
    "scheme": "cuentabirras",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elrober10.cuentabirras",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.elrober10.cuentabirras",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CuentaBirras necesita acceso a tus fotos para ponerle una imagen a un bar.",
          "cameraPermission": "CuentaBirras necesita acceso a la cámara para hacer una foto de un bar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CuentaBirras usa tu ubicación para ordenar los bares por cercanía y evitar crear bares duplicados."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "CuentaBirras necesita acceso a tus contactos para poder invitar a alguien a vincular vuestras cuentas."
        }
      ],
      "expo-notifications",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b033ad0-48cb-4e04-ae6a-059a42e35b31"
      }
    }
  }
}
