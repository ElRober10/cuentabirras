{
  "expo": {
    "name": "CuentaBirras",
    "slug": "CuentaBirras",
    "version": "1.0.0",
    "scheme": "cuentabirras",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CuentaBirras necesita acceso a tus fotos para ponerle una imagen a un bar.",
          "cameraPermission": "CuentaBirras necesita acceso a la cámara para hacer una foto de un bar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CuentaBirras usa tu ubicación para ordenar los bares por cercanía y evitar crear bares duplicados."
        }
      ]
    ]
  }
}
