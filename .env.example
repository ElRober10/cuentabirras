# Copia este archivo a .env y rellena los valores reales.
# .env nunca se sube a git (ver .gitignore).

# Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Settings -> API Keys -> Publishable key (sb_publishable_...)
# NUNCA pongas aquí la Secret key (sb_secret_...)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Settings -> Database -> contraseña de conexión directa a Postgres.
# Solo necesaria para migraciones/CLI, no la usa la app.
SUPABASE_DB_PASSWORD=
